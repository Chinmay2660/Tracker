# CareerFlow frontend — copy to .env and adjust for your environment
# cp .env.example .env

# CareerFlow API (Express backend)
VITE_API_URL=http://localhost:8000

# GrowthHub (Next.js) — used for sidebar link + SSO handoff
VITE_GROWTHHUB_URL=http://localhost:4000

# Vite exposes only VITE_* vars to the browser — never put secrets here.
# Shared auth secrets live in ../backend/.env (SESSION_SECRET, MONGODB_URI, etc.)
