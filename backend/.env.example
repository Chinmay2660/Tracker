# Required for production browser clients (CORS + CSRF). Comma-separated is OK.
FRONTEND_URL=https://your-app.vercel.app
# Optional: multiple sites or www + apex
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://www.your-app.vercel.app

# Optional: allow every https://*.vercel.app (preview deployments). Use only if you trust preview URLs.
# ALLOW_VERCEL_PREVIEW_ORIGINS=true

# Set on non-Vercel hosts that sit behind a reverse proxy (Railway, Fly, etc.) so rate limiting sees real client IPs.
# TRUST_PROXY=1
