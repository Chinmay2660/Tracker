# Shared platform auth — use the same values in GrowthHub (.env)
MONGODB_URI=mongodb://127.0.0.1:27017/platform
SESSION_SECRET=change-me-to-a-long-random-string
# Optional: share cookie across subdomains (e.g. .yourdomain.com)
# COOKIE_DOMAIN=.yourdomain.com

# CareerFlow frontend (Vite)
FRONTEND_URL=http://localhost:3000
# GrowthHub (Next.js)
GROWTHHUB_URL=http://localhost:4000
SWITCH_PREP_URL=http://localhost:4000
# GrowthHub browser URL (CareerFlow frontend .env)
VITE_GROWTHHUB_URL=http://localhost:4000

JWT_SECRET=your-jwt-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback

# Comma-separated extra browser origins for CORS + CSRF
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# Rate limiting — off by default in development; set true in production
# RATE_LIMIT_ENABLED=false
# Login/register/guest limits are separate; defaults to RATE_LIMIT_ENABLED when unset
# AUTH_RATE_LIMIT_ENABLED=false
