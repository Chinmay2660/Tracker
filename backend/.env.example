# CareerFlow API — copy to .env and fill in values
# cp .env.example .env

PORT=8000
UPLOAD_DIR=./uploads/resumes
NODE_ENV=development

# ── Shared platform auth (MUST match GrowthHub .env.local) ─────────────────────
# Same database + session secret = one login for CareerFlow + GrowthHub
MONGODB_URI=mongodb://127.0.0.1:27017/platform
# Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/platform?retryWrites=true&w=majority
SESSION_SECRET=change-me-to-a-long-random-string
# Generate: openssl rand -hex 32

# Optional: share cookies across subdomains in production (e.g. .yourdomain.com)
# COOKIE_DOMAIN=.yourdomain.com

# ── App URLs (local dev) ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
GROWTHHUB_URL=http://localhost:4000

# ── CareerFlow-only (not used by GrowthHub) ───────────────────────────────────
# Legacy Bearer-token fallback; cookie auth uses SESSION_SECRET above
JWT_SECRET=change-me-to-another-random-string

# ── Google OAuth (configure redirect URI in Google Cloud Console) ─────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback

# CORS + OAuth return-to allowlist (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# ── Optional ──────────────────────────────────────────────────────────────────
# Rate limiting — off by default in development; set true in production
# RATE_LIMIT_ENABLED=false
# AUTH_RATE_LIMIT_ENABLED=false

# CareerFlow frontend env is separate: ../frontend/.env (VITE_API_URL, VITE_GROWTHHUB_URL)
# GrowthHub env is separate: ../../Productivity-Tracker/.env.local
